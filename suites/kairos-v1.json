{
  "schema": 1,
  "profile": "kairos-v1",
  "modules": {
    "hook-guard": {
      "adapter_optional": true,
      "why": "Hook commands in a repository's .claude settings run on the machine of anyone who opens an agent session there. A branch can change them; this check holds them to fingerprints kept here, so a changed hook fails CI until the owner adds its fingerprint centrally (Zach, 2026-11-12).",
      "allowed_hook_commands_sha256": {
        "eraevous/MtG": [
          "c044525e192a71af29609b04621141db6b9464fe896effc892895c6f3b9d51ca"
        ],
        "eraevous/Telosmith": [
          "c1b556106e40066c153423a0761a11313c0af0ab1a8d0ff1b0cce7c57d42a7fb"
        ],
        "eraevous/crank-mem-eval": [
          "5bd1822b388c63f2cedbda2118d17cbaf4574feddacf8dd04376263a5e639e29"
        ],
        "eraevous/kairos-infra": [
          "3b62d0a13d1845ec31489f25be40e90bce3bb872251fdea0ea4a0fb8d0237fbc"
        ],
        "*": [
          "5bd1822b388c63f2cedbda2118d17cbaf4574feddacf8dd04376263a5e639e29",
          "cb8eaebeb5becbf1c2363d3a465d8f2189da380877a716a77afb47372545d3fb",
          "e019ae40b515a54546c2e53699bca6863e6568da534264afd4bbc2d744719896",
          "599883c23c35ff4f4a2e45b4d6ec499c24bddb2e4e2a98d16bb383e71b4622d5"
        ]
      },
      "run_first": true,
      "forbidden_root_modules": [
        "aec",
        "runpy",
        "site",
        "sitecustomize",
        "usercustomize",
        "encodings",
        "codecs",
        "os",
        "io",
        "abc"
      ],
      "allowed_settings_extras_sha256": {
        "*": []
      }
    },
    "repository-tests": {
      "allow_skips": false,
      "timeout_seconds": 600,
      "allowed_skip_reasons": [
        {
          "reason": "specify CLI not installed",
          "repos": [
            "eraevous/Telosmith"
          ],
          "why": "Optional Spec Kit integration test needs the external specify CLI, which CI does not install."
        },
        {
          "reason": "KB database not present",
          "repos": [
            "eraevous/MtG"
          ],
          "why": "KB-backed tests need the KB release downloaded per data/README.md; CI does not download it. MtG's own CI covers the rest."
        },
        {
          "reason": "KB database not installed",
          "repos": [
            "eraevous/MtG"
          ],
          "why": "Same as above (older message wording in the same test file)."
        },
        {
          "reason": "KB release predates",
          "repos": [
            "eraevous/MtG"
          ],
          "why": "Version guard for a KB-backed test (C-024); only reachable when a KB is present."
        }
      ]
    },
    "telosmith": {
      "timeout_seconds": 300
    },
    "repository-commands": {
      "optional": true,
      "timeout_seconds": 900,
      "allowed_programs": [
        "{python}",
        "node"
      ]
    }
  }
}
